Set-Content -Path .gitignore -Value @"
# Dependencies
node_modules/
*/node_modules/

# Environment files
.env
.env.local
.env.production
.env.development

# Logs
*.log
npm-debug.log*

# Build outputs
build/
dist/
.next/
out/

# Vercel
.vercel

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Misc
coverage/
.cache/
"@
.env*
